# Next.js 前端環境變數範本
# 複製此檔案為 .env.local 並填入實際值

# PostgreSQL 連線字串（僅伺服器端使用，絕對不可加 NEXT_PUBLIC_ 前綴）
# 本機開發可用 db/schema.sql 初始化的資料庫，例如：
#   docker run -d --name eduscraper-pg -e POSTGRES_USER=eduscraper -e POSTGRES_PASSWORD=devpw \
#     -e POSTGRES_DB=eduscraper -p 127.0.0.1:5432:5432 postgres:17-alpine
DATABASE_URL=postgresql://eduscraper:devpw@127.0.0.1:5432/eduscraper

# Google AdSense 廣告主 ID（格式：ca-pub-xxxxxxxxxxxxxxxxxx）
# 不填則顯示開發佔位符
NEXT_PUBLIC_ADSENSE_ID=

# 網站正式網址（用於 sitemap、OG 標籤等）
NEXT_PUBLIC_SITE_URL=
